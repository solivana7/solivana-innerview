# Copy to .env for local dev. Real values go in Railway service variables.

# Required: Claude API key for AI analysis
ANTHROPIC_API_KEY=sk-ant-api03-your-real-key-here

# Postgres connection string. On Railway, this is auto-injected by the
# Postgres add-on as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:pass@host:port/database
